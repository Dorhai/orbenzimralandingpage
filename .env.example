# SMTP — use the mail settings from your domain host (orbenzimra.co.il)
SMTP_HOST=mail.orbenzimra.co.il
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=or@orbenzimra.co.il
SMTP_PASS=your-mailbox-password

# Addresses
CONTACT_FROM_EMAIL=or@orbenzimra.co.il
CONTACT_TO_EMAIL=or@orbenzimra.co.il

# Public site URL (used for logo image + links in emails)
SITE_URL=https://orbenzimra.co.il

# Instagram profile (shown in auto-reply footer)
INSTAGRAM_URL=https://www.instagram.com/your-profile

# API port (dev)
PORT=3001
