# Resend — https://resend.com/api-keys
# CONTACT_FROM_EMAIL must use a domain verified in Resend.
# Until verified, you may only send from onboarding@resend.dev to your account email.
RESEND_API_KEY=re_your_api_key

CONTACT_FROM_EMAIL=contact@orbenzimrafitnesscoach.com
CONTACT_TO_EMAIL=contact@orbenzimrafitnesscoach.com

# Public site URL — use www (Vercel). Apex (no www) may show SSL errors on GoDaddy.
SITE_URL=https://www.orbenzimrafitnesscoach.com

# Optional: override logo URL in emails
# EMAIL_LOGO_URL=https://www.orbenzimrafitnesscoach.com/images/email-logo.png

# Instagram profile (auto-reply footer)
INSTAGRAM_URL=https://www.instagram.com/or_benzimra/

# API port (dev)
PORT=3001
